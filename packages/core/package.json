{
  "name": "@ajaymyth/core",
  "version": "2.0.0",
  "description": "AfterLink Protocol Core - Frame codec and serialization",
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "browser": {
    "net": false,
    "tls": false,
    "zlib": false,
    "./src/TcpClient.js": false
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./errors": {
      "types": "./types/errors.d.ts",
      "require": "./src/errors/index.js",
      "default": "./src/errors/index.js"
    },
    "./types/errors": {
      "types": "./types/errors.d.ts"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AJAYMYTH/AfterLink.git",
    "directory": "packages/core"
  },
  "keywords": [
    "afterlink",
    "protocol",
    "binary",
    "codec",
    "tcp",
    "messaging",
    "pubsub",
    "msgpack"
  ],
  "files": [
    "src/**/*.js",
    "types/**/*.d.ts",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "msgpackr": "^1.10.0"
  },
  "devDependencies": {
    "vitest": "^2.1.0"
  }
}
