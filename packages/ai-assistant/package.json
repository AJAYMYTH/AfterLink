{
  "name": "@ajaymyth/ai-assistant",
  "version": "1.2.4",
  "description": "Offline AI assistant for AfterLink — 100% local RAG pipeline with FAISS vector search, BM25, cross-encoder reranking, and an interactive terminal UI",
  "main": "src/chat.js",
  "bin": {
    "afterlink-ai": "src/chat.js"
  },
  "scripts": {
    "ingest": "node src/ingest.js",
    "chat": "node src/chat.js",
    "benchmark": "node src/benchmark.js"
  },
  "keywords": [
    "afterlink",
    "ai",
    "assistant",
    "rag",
    "offline",
    "llm",
    "vector-search",
    "faiss",
    "bm25",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AJAYMYTH/AfterLink.git",
    "directory": "packages/ai-assistant"
  },
  "files": [
    "src/**/*.js",
    "src/afterlink-knowledge.json",
    "README.md",
    "MODEL_EXPLANATION.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@langchain/community": "^1.1.29",
    "@xenova/transformers": "^2.17.2",
    "chalk": "^4.1.2",
    "faiss-node": "^0.5.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
