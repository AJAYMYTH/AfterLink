{
  "name": "afterlink",
  "version": "1.0.0",
  "description": "AfterLink Communication Protocol: For Reliable and Fast communication",
  "private": true,
  "workspaces": [
    "packages/*",
    "benchmarks",
    "examples/*"
  ],
  "scripts": {
    "test": "pnpm -r test",
    "test:core": "pnpm --filter @afterlink/core test",
    "test:server": "pnpm --filter @afterlink/server test",
    "test:client": "pnpm --filter @afterlink/client test",
    "release:patch": "npm version patch && git push --tags",
    "release:minor": "npm version minor && git push --tags",
    "release:major": "npm version major && git push --tags",
    "changelog:check": "node scripts/check-changelog.js"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.24.3",
      "vite": ">=6.4.2"
    }
  }
}
