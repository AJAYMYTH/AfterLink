{
  "name": "afterlink-workspace",
  "version": "2.0.1",
  "description": "AfterLink Communication Protocol: For Reliable and Fast communication",
  "private": true,
  "workspaces": [
    "packages/*",
    "benchmarks",
    "examples/*"
  ],
  "scripts": {
    "build": "pnpm -r build --if-present",
    "test": "pnpm -r test",
    "test:core": "pnpm --filter @ajaymyth/core test",
    "test:server": "pnpm --filter @ajaymyth/server test",
    "test:client": "pnpm --filter @ajaymyth/client test",
    "test:cluster": "pnpm --filter @ajaymyth/cluster test",
    "release:patch": "npm version patch && git push --tags",
    "release:minor": "npm version minor && git push --tags",
    "release:major": "npm version major && git push --tags",
    "changelog:check": "node scripts/check-changelog.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
